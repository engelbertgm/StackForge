{
  "name": "stackforge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "check": "node --experimental-strip-types --test src/rules.test.ts src/catalog/catalog.test.ts src/routing.test.ts src/snap.test.ts src/design/contrast.test.ts src/search.test.ts src/lib/utils.test.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "dup": "jscpd",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jscpd": "5.4.2",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
